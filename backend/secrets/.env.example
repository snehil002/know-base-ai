# Create a file in this directory called - .env
# This is an example secret file with the exact environment variable names

# This app server's port
PORT=5000

# Mongo DB connection string url
MONGODB_URI=mongodb://127.0.0.1:27017/dbname

# JWT secret key for authentication
JWT_SECRET=

# This app server's CORS configuration - allowed origin
FRONTEND_URL=

# OpenAi (LLM) api key
OPENAI_API_KEY=

# Pinecone DB (Vector DB) - api key, index name, index host url
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_INDEX_HOST=

# Google Cloud Storage bucket name
GCS_BUCKET_NAME=
